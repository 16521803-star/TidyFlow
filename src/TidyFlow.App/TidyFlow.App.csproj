<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TidyFlow.Core\TidyFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.3.0</Version>
    <AssemblyTitle>TidyFlow</AssemblyTitle>
    <Product>TidyFlow</Product>
    <Authors>Thang Huynh</Authors>
    <Description>Smart Windows folder organizer and list-based batch file renamer</Description>
  </PropertyGroup>

</Project>
