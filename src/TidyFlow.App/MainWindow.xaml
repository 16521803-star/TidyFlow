<ui:FluentWindow x:Class="TidyFlow.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:coreModels="clr-namespace:TidyFlow.Core.Models;assembly=TidyFlow.Core"
                 mc:Ignorable="d"
                 Title="{DynamicResource Str_AppTitle}"
                 Icon="pack://application:,,,/Assets/tidyflow.ico"
                 Width="1160"
                 Height="730"
                 MinWidth="960"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="PreviewGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static coreModels:OperationStatus.Skipped}">
                    <Setter Property="Opacity" Value="0.58" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static coreModels:OperationStatus.ConflictResolved}">
                    <Setter Property="Foreground" Value="#FBBF24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static coreModels:OperationStatus.Error}">
                    <Setter Property="Foreground" Value="#F87171" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="TidyFlow" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="12,0,12,0" VerticalAlignment="Center">
                    <ui:Button Content="{Binding UndoButtonText}"
                               Command="{Binding UndoLatestCommand}"
                               Appearance="Secondary"
                               Padding="10,5"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Width="112"
                              Margin="0,0,8,0"
                              Padding="8,4" />
                    <ui:Button Content="{Binding UpdateButtonText}"
                               Command="{Binding CheckUpdatesCommand}"
                               Appearance="Transparent"
                               Padding="10,5"
                               Margin="0,0,6,0" />
                    <ui:Button Content="{Binding ThemeButtonText}"
                               Command="{Binding ToggleThemeCommand}"
                               Appearance="Transparent"
                               Padding="10,5"
                               Margin="0,0,6,0" />
                    <ui:Button Content="{DynamicResource Str_AboutButton}"
                               Click="About_Click"
                               Appearance="Transparent"
                               Padding="10,5" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Feedback Banner -->
        <ui:InfoBar Grid.Row="1"
                    Margin="16,4,16,8"
                    Title="{Binding StatusTitle}"
                    Message="{Binding StatusMessage}"
                    Severity="{Binding StatusSeverity}"
                    IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                    IsClosable="True" />

        <!-- Main Workspace Tabs -->
        <TabControl Grid.Row="2" Margin="16,0,16,16" SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <!-- TAB 1: ORGANIZE FOLDER -->
            <TabItem Header="{DynamicResource Str_TabOrganize}">
                <Grid Margin="0,12,0,0" AllowDrop="True" Drop="OrganizeArea_Drop" DragOver="Files_DragOver">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Folder Selection Bar -->
                    <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource Str_TargetFolder}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Margin="0,0,10,0" />

                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding Organize.FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{DynamicResource Str_TargetFolderHint}"
                                        Margin="0,0,8,0" />

                            <ui:Button Grid.Column="2"
                                       Content="{DynamicResource Str_Downloads}"
                                       Command="{Binding Organize.SelectDownloadsCommand}"
                                       Margin="0,0,6,0" />

                            <ui:Button Grid.Column="3"
                                       Content="{DynamicResource Str_Browse}"
                                       Click="BrowseOrganizeFolder_Click"
                                       Margin="0,0,6,0" />

                            <ui:Button Grid.Column="4"
                                       Content="{DynamicResource Str_ScanAndPreview}"
                                       Appearance="Primary"
                                       Command="{Binding Organize.ScanAndPreviewCommand}" />
                        </Grid>
                    </ui:Card>

                    <!-- Grouping Options & Custom Rules -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <!-- Options Card -->
                        <ui:Card Grid.Column="0" Padding="14" VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_GroupingOptions}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_ModeLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Organize.AvailableModeOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Organize.SelectedMode}" />
                                </Grid>

                                <StackPanel Margin="0,0,0,8" Visibility="{Binding Organize.IsDateMode, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_DateFormatLabel}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Organize.AvailableDateFormats}"
                                                  SelectedItem="{Binding Organize.SelectedDateFormat}" />
                                    </Grid>
                                    <CheckBox Content="{DynamicResource Str_UseExifDate}"
                                              IsChecked="{Binding Organize.UseExifDateWhenAvailable}" />
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_MinAgeDays}" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1"
                                                Text="{Binding Organize.GlobalMinimumAgeDaysText, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{DynamicResource Str_MinAgeHint}" />
                                </Grid>

                                <CheckBox Content="{DynamicResource Str_IgnoreActiveDownloads}"
                                          IsChecked="{Binding Organize.IgnoreActiveDownloads}"
                                          Margin="0,4,0,4" />
                                <CheckBox Content="{DynamicResource Str_IncludeSubdirs}"
                                          IsChecked="{Binding Organize.IncludeSubdirectories}" />
                            </StackPanel>
                        </ui:Card>

                        <!-- Custom Keyword / Extension Rules Card -->
                        <ui:Card Grid.Column="2" Padding="14" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{DynamicResource Str_CustomRulesTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Margin="0,0,0,8" />

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox Grid.Column="0"
                                                Text="{Binding Organize.NewRuleFolder, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{DynamicResource Str_RuleFolderHint}" />
                                    <ui:TextBox Grid.Column="2"
                                                Text="{Binding Organize.NewRuleKeywords, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{DynamicResource Str_RuleKeywordsHint}" />
                                    <ui:TextBox Grid.Column="4"
                                                Text="{Binding Organize.NewRuleExtensions, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{DynamicResource Str_RuleExtHint}" />
                                    <ComboBox Grid.Column="6"
                                              ItemsSource="{Binding Organize.AvailableRuleMatchLogicOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Organize.NewRuleMatchLogic}" />
                                    <ui:TextBox Grid.Column="8"
                                                Text="{Binding Organize.NewRuleAgeDaysText, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{DynamicResource Str_RuleDaysHint}" />
                                    <ui:Button Grid.Column="10"
                                               Content="{DynamicResource Str_Add}"
                                               Command="{Binding Organize.AddRuleCommand}" />
                                </Grid>

                                <ListBox Grid.Row="2"
                                         ItemsSource="{Binding Organize.CustomRules}"
                                         MaxHeight="82"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                    <Run Text="{Binding TargetFolder, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" [" Foreground="#9CA3AF" />
                                                    <Run Text="{Binding LogicDisplay, Mode=OneWay}" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                    <Run Text="]" Foreground="#9CA3AF" />
                                                    <Run Text="  |  KW: " Foreground="#9CA3AF" />
                                                    <Run Text="{Binding KeywordsCsv, Mode=OneWay}" />
                                                    <Run Text="  |  Ext: " Foreground="#9CA3AF" />
                                                    <Run Text="{Binding ExtensionsCsv, Mode=OneWay}" />
                                                    <Run Text="{Binding AgeDisplay, Mode=OneWay}" Foreground="#FBBF24" />
                                                </TextBlock>
                                                <ui:Button Grid.Column="1"
                                                           Content="{DynamicResource Str_Remove}"
                                                           Appearance="Transparent"
                                                           Padding="8,2"
                                                           Command="{Binding DataContext.Organize.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </ui:Card>
                    </Grid>

                    <!-- Dry-Run Preview Grid -->
                    <DataGrid Grid.Row="2"
                              Style="{StaticResource PreviewGridStyle}"
                              ItemsSource="{Binding Organize.PreviewRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource PreviewRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_ColIndex}" Binding="{Binding Index}" Width="48" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColStatus}" Binding="{Binding StatusText}" Width="130" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColSourceFile}" Binding="{Binding SourceName}" Width="1.2*" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColDestRelative}" Binding="{Binding TargetDisplay}" Width="1.5*" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColNote}" Binding="{Binding Note}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Action Bar -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Organize.PreviewSummary}"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium" />

                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Str_ApplyOrganize}"
                                   Appearance="Primary"
                                   Padding="18,8"
                                   Click="ApplyOrganize_Click"
                                   IsEnabled="{Binding Organize.CanApply}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: LIST BATCH RENAME -->
            <TabItem Header="{DynamicResource Str_TabRename}">
                <Grid Margin="0,12,0,0" AllowDrop="True" Drop="RenameArea_Drop" DragOver="Files_DragOver">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.15*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Split: Ordered Files (Left) & Name List / Options (Right) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Ordered Files -->
                        <ui:Card Grid.Column="0" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Str_RenameSelectHeader}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Content="{DynamicResource Str_AddFiles}" Click="AddRenameFiles_Click" Margin="0,0,6,0" Padding="10,4" />
                                        <ui:Button Content="{DynamicResource Str_FromFolder}" Click="AddRenameFolder_Click" Padding="10,4" />
                                    </StackPanel>
                                </DockPanel>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Rename.Files}"
                                         SelectedItem="{Binding Rename.SelectedFileItem, Mode=TwoWay}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat=#{0}}" Foreground="#9CA3AF" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding FolderName}" Foreground="#9CA3AF" Margin="8,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                    <ui:Button Content="{DynamicResource Str_MoveUp}" Command="{Binding Rename.MoveUpCommand}" Margin="0,0,6,0" Padding="10,4" />
                                    <ui:Button Content="{DynamicResource Str_MoveDown}" Command="{Binding Rename.MoveDownCommand}" Margin="0,0,6,0" Padding="10,4" />
                                    <ui:Button Content="{DynamicResource Str_SortAZ}" Command="{Binding Rename.SortByNameCommand}" Margin="0,0,6,0" Padding="10,4" />
                                    <ui:Button Content="{DynamicResource Str_SortDate}" Command="{Binding Rename.SortByDateCommand}" Margin="0,0,6,0" Padding="10,4" />
                                    <ui:Button Content="{DynamicResource Str_Remove}" Command="{Binding Rename.RemoveSelectedCommand}" Margin="0,0,6,0" Padding="10,4" />
                                    <ui:Button Content="{DynamicResource Str_Clear}" Command="{Binding Rename.ClearFilesCommand}" Padding="10,4" />
                                </WrapPanel>
                            </Grid>
                        </ui:Card>

                        <!-- Right: Target Name List & Options -->
                        <ui:Card Grid.Column="2" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Mode Switch -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton Content="{DynamicResource Str_RenameFromList}"
                                                 IsChecked="{Binding Rename.UseListMode}"
                                                 GroupName="RenameMode"
                                                 Margin="0,0,16,0" />
                                    <RadioButton Content="{DynamicResource Str_QuickTemplate}"
                                                 IsChecked="{Binding Rename.UseTemplateMode}"
                                                 GroupName="RenameMode" />
                                </StackPanel>

                                <!-- List Mode Body -->
                                <Grid Grid.Row="1" Visibility="{Binding Rename.UseListMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Rename.ParsedListCountText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#9CA3AF" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Content="{DynamicResource Str_OcrSuggest}"
                                                       Command="{Binding Rename.SuggestNamesFromOcrCommand}"
                                                       Margin="0,0,6,0"
                                                       Padding="10,4" />
                                            <ui:Button Content="{DynamicResource Str_PasteClipboard}"
                                                       Command="{Binding Rename.PasteClipboardListCommand}"
                                                       Padding="10,4" />
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBox Grid.Row="1"
                                             Text="{Binding Rename.RawNameListText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             MinHeight="96"
                                             VerticalAlignment="Stretch"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas" />

                                    <!-- Saved List Presets -->
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding Rename.SavedLists}"
                                                  SelectedItem="{Binding Rename.SelectedSavedList}"
                                                  DisplayMemberPath="Name" />
                                        <ui:Button Grid.Column="2"
                                                   Content="{DynamicResource Str_Del}"
                                                   Command="{Binding Rename.DeleteSavedListCommand}"
                                                   Padding="8,4" />
                                        <ui:TextBox Grid.Column="4"
                                                    Text="{Binding Rename.NewListPresetName, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{DynamicResource Str_SaveListAs}" />
                                        <ui:Button Grid.Column="6"
                                                   Content="{DynamicResource Str_Save}"
                                                   Command="{Binding Rename.SaveCurrentListCommand}"
                                                   Padding="10,4" />
                                    </Grid>
                                </Grid>

                                <!-- Template Mode Body -->
                                <StackPanel Grid.Row="1" Visibility="{Binding Rename.UseTemplateMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource Str_PatternLabel}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Rename.TemplatePattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                    <TextBlock Text="{DynamicResource Str_FindText}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Rename.FindText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                    <TextBlock Text="{DynamicResource Str_ReplaceWith}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Rename.ReplaceText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!-- Shared Options & Destination Folder -->
                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox Content="{DynamicResource Str_KeepExt}"
                                                  IsChecked="{Binding Rename.PreserveOriginalExtension}"
                                                  Margin="0,0,14,0" />
                                        <CheckBox Content="{DynamicResource Str_CleanDuplicates}"
                                                  IsChecked="{Binding Rename.CleanDuplicateMarkers}" />
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="1.45*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0"
                                                    Text="{Binding Rename.Prefix, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{DynamicResource Str_PrefixHint}" />
                                        <ui:TextBox Grid.Column="2"
                                                    Text="{Binding Rename.Suffix, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{DynamicResource Str_SuffixHint}" />
                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{Binding Rename.AvailableMismatchOptions}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Rename.MismatchBehavior}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource Str_SaveTo}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <ui:TextBox Grid.Column="1"
                                                    Text="{Binding Rename.OutputFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{DynamicResource Str_OutputFolderHint}" />
                                        <ui:Button Grid.Column="3"
                                                   Content="{DynamicResource Str_Browse}"
                                                   Click="BrowseRenameOutputFolder_Click"
                                                   Padding="10,4" />
                                        <ui:Button Grid.Column="5"
                                                   Content="{DynamicResource Str_Clear}"
                                                   Command="{Binding Rename.ClearOutputFolderCommand}"
                                                   Padding="8,4" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </Grid>

                    <!-- Live Preview DataGrid -->
                    <DataGrid Grid.Row="2"
                              Style="{StaticResource PreviewGridStyle}"
                              ItemsSource="{Binding Rename.PreviewRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource PreviewRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_ColIndex}" Binding="{Binding Index}" Width="48" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColStatus}" Binding="{Binding StatusText}" Width="130" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColOrigName}" Binding="{Binding SourceName}" Width="1.2*" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColNewName}" Binding="{Binding TargetDisplay}" Width="1.5*" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColNote}" Binding="{Binding Note}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Action Bar -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Rename.PreviewSummary}"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium" />

                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Str_ApplyRename}"
                                   Appearance="Primary"
                                   Padding="18,8"
                                   Click="ApplyRename_Click"
                                   IsEnabled="{Binding Rename.CanApply}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: DUPLICATE FINDER -->
            <TabItem Header="{DynamicResource Str_TabDuplicates}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Str_ScanFolder}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <ui:TextBox Grid.Column="1" Text="{Binding Duplicates.FolderPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="2" Content="{DynamicResource Str_Downloads}" Command="{Binding Duplicates.SelectDownloadsCommand}" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="3" Content="{DynamicResource Str_Browse}" Click="BrowseDuplicatesFolder_Click" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="4" Content="{DynamicResource Str_ScanDuplicates}" Appearance="Primary" Command="{Binding Duplicates.ScanCommand}" />
                        </Grid>
                    </ui:Card>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <CheckBox Content="{DynamicResource Str_IncludeSubdirs}"
                                  IsChecked="{Binding Duplicates.IncludeSubdirectories}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="{DynamicResource Str_KeepOldest}" Command="{Binding Duplicates.KeepOldestCommand}" Margin="0,0,6,0" Padding="10,4" />
                            <ui:Button Content="{DynamicResource Str_KeepNewest}" Command="{Binding Duplicates.KeepNewestCommand}" Margin="0,0,6,0" Padding="10,4" />
                            <ui:Button Content="{DynamicResource Str_UncheckAll}" Command="{Binding Duplicates.UncheckAllCommand}" Padding="10,4" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              Style="{StaticResource PreviewGridStyle}"
                              ItemsSource="{Binding Duplicates.DuplicateRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource PreviewRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource Str_ColTrash}" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelectedForDeletion, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Str_ColGroup}" Binding="{Binding GroupNumber}" Width="72" IsReadOnly="True" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColSize}" Binding="{Binding SizeText}" Width="96" IsReadOnly="True" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColFileName}" Binding="{Binding FileName}" Width="1.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColModified}" Binding="{Binding ModifiedText}" Width="135" IsReadOnly="True" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColFolder}" Binding="{Binding FolderPath}" Width="1.5*" IsReadOnly="True" />
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding ShortHash}" Width="88" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Duplicates.ScanSummary}" VerticalAlignment="Center" FontWeight="Medium" />
                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Str_MoveCheckedRecycle}"
                                   Appearance="Danger"
                                   Padding="16,8"
                                   Click="DeleteDuplicateFiles_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 4: SPACE CLEANER -->
            <TabItem Header="{DynamicResource Str_TabSpace}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Str_AnalyzeFolder}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <ui:TextBox Grid.Column="1" Text="{Binding SpaceCleaner.FolderPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="2" Content="{DynamicResource Str_Downloads}" Command="{Binding SpaceCleaner.SelectDownloadsCommand}" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="3" Content="{DynamicResource Str_Browse}" Click="BrowseSpaceFolder_Click" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="4" Content="{DynamicResource Str_ScanSpace}" Appearance="Primary" Command="{Binding SpaceCleaner.ScanCommand}" />
                        </Grid>
                    </ui:Card>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Top Largest Files -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource Str_LargestFilesTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource PreviewGridStyle}"
                                      ItemsSource="{Binding SpaceCleaner.LargestFiles}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowStyle="{StaticResource PreviewRowStyle}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{DynamicResource Str_ColTrash}" Width="58">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelectedForDeletion, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{DynamicResource Str_ColIndex}" Binding="{Binding Rank}" Width="44" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{DynamicResource Str_ColSize}" Binding="{Binding SizeText}" Width="96" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{DynamicResource Str_ColFileName}" Binding="{Binding Name}" Width="1.2*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{DynamicResource Str_ColFolder}" Binding="{Binding FolderPath}" Width="1.3*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Right: Subfolder Sizes & Empty Folders -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0.8*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource Str_SubfolderUsageTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource PreviewGridStyle}"
                                      ItemsSource="{Binding SpaceCleaner.TopSubfolders}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowStyle="{StaticResource PreviewRowStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Str_ColFolder}" Binding="{Binding Name}" Width="1.3*" />
                                    <DataGridTextColumn Header="{DynamicResource Str_ColFiles}" Binding="{Binding FileCount}" Width="74" />
                                    <DataGridTextColumn Header="{DynamicResource Str_ColSize}" Binding="{Binding SizeText}" Width="96" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="3" Margin="0,0,0,6">
                                <TextBlock Text="{Binding SpaceCleaner.EmptyFolderCount, StringFormat='Empty: {0}'}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ui:Button Content="{DynamicResource Str_CleanEmpty}"
                                           Click="CleanEmptyFolders_Click"
                                           HorizontalAlignment="Right"
                                           Padding="10,4" />
                            </DockPanel>

                            <ListBox Grid.Row="4"
                                     ItemsSource="{Binding SpaceCleaner.EmptyFolders}"
                                     DisplayMemberPath="RelativePath"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding SpaceCleaner.ScanSummary}" VerticalAlignment="Center" FontWeight="Medium" />
                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Str_MoveSelectedRecycle}"
                                   Appearance="Danger"
                                   Padding="16,8"
                                   Click="DeleteLargeFiles_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 5: IMAGE RESIZER -->
            <TabItem Header="{DynamicResource Str_TabImage}">
                <Grid Margin="0,12,0,0" AllowDrop="True" Drop="ImagesArea_Drop" DragOver="Files_DragOver">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Padding="12" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Str_ImageHeaderHint}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="{DynamicResource Str_AddImages}" Click="AddImages_Click" Margin="0,0,6,0" Padding="10,5" />
                                <ui:Button Content="{DynamicResource Str_FromFolder}" Click="AddImagesFolder_Click" Margin="0,0,6,0" Padding="10,5" />
                                <ui:Button Content="{DynamicResource Str_Clear}" Command="{Binding ImageResizer.ClearFilesCommand}" Padding="10,5" />
                            </StackPanel>
                        </DockPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.55*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.85*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.7*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_ResizeMode}" FontSize="11" Foreground="#9CA3AF" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Str_WidthPx}" FontSize="11" Foreground="#9CA3AF" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{DynamicResource Str_HeightPx}" FontSize="11" Foreground="#9CA3AF" />
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="{DynamicResource Str_ScalePct}" FontSize="11" Foreground="#9CA3AF" />
                                <TextBlock Grid.Row="0" Grid.Column="8" Text="{DynamicResource Str_Format}" FontSize="11" Foreground="#9CA3AF" />
                                <TextBlock Grid.Row="0" Grid.Column="10" Text="{DynamicResource Str_SuffixLabel}" FontSize="11" Foreground="#9CA3AF" />

                                <ComboBox Grid.Row="2" Grid.Column="0"
                                          ItemsSource="{Binding ImageResizer.AvailableModeOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ImageResizer.SelectedMode}" />
                                <ui:TextBox Grid.Row="2" Grid.Column="2"
                                            Text="{Binding ImageResizer.TargetWidthText, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ImageResizer.IsWidthEnabled}" />
                                <ui:TextBox Grid.Row="2" Grid.Column="4"
                                            Text="{Binding ImageResizer.TargetHeightText, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ImageResizer.IsHeightEnabled}" />
                                <ui:TextBox Grid.Row="2" Grid.Column="6"
                                            Text="{Binding ImageResizer.PercentageText, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ImageResizer.IsPercentageEnabled}" />
                                <ComboBox Grid.Row="2" Grid.Column="8"
                                          ItemsSource="{Binding ImageResizer.AvailableFormats}"
                                          SelectedItem="{Binding ImageResizer.SelectedFormat}" />
                                <ui:TextBox Grid.Row="2" Grid.Column="10"
                                            Text="{Binding ImageResizer.Suffix, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          Content="{DynamicResource Str_DoNotUpscale}"
                                          IsChecked="{Binding ImageResizer.DoNotUpscale}"
                                          IsEnabled="{Binding ImageResizer.IsDoNotUpscaleEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,18,0" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_SaveTo}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox Grid.Column="2"
                                            Text="{Binding ImageResizer.OutputFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{DynamicResource Str_OutputFolderHint}" />
                                <ui:Button Grid.Column="4" Content="{DynamicResource Str_Browse}" Click="BrowseImageOutputFolder_Click" Padding="10,4" />
                                <ui:Button Grid.Column="6" Content="{DynamicResource Str_Clear}" Command="{Binding ImageResizer.ClearOutputFolderCommand}" Padding="8,4" />
                            </Grid>
                        </Grid>
                    </ui:Card>

                    <DataGrid Grid.Row="2"
                              Style="{StaticResource PreviewGridStyle}"
                              ItemsSource="{Binding ImageResizer.PreviewRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource PreviewRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_ColIndex}" Binding="{Binding Index}" Width="48" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColStatus}" Binding="{Binding StatusText}" Width="130" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColSourceImage}" Binding="{Binding SourceName}" Width="1.2*" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColOutputFile}" Binding="{Binding TargetDisplay}" Width="1.4*" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColOperation}" Binding="{Binding Note}" Width="1.1*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding ImageResizer.PreviewSummary}" VerticalAlignment="Center" FontWeight="Medium" />
                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Str_ApplyImages}"
                                   Appearance="Primary"
                                   Padding="18,8"
                                   Command="{Binding ImageResizer.ApplyCommand}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 6: AUTOMATION & TOOLS -->
            <TabItem Header="{DynamicResource Str_TabAutomation}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Watch Folder Card -->
                    <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Str_WatchTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Automation.WatchStatusText}"
                                           Foreground="#9CA3AF"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_FolderLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:TextBox Grid.Column="1" Text="{Binding Automation.WatchFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="3" Content="{DynamicResource Str_Browse}" Click="BrowseWatchFolder_Click" />
                                <ComboBox Grid.Column="5"
                                          ItemsSource="{Binding Automation.AvailableWatchModeOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Automation.WatchMode}" />
                                <ui:Button Grid.Column="7"
                                           Content="{Binding Automation.WatchButtonText}"
                                           Appearance="Primary"
                                           Command="{Binding Automation.ToggleWatchCommand}" />
                            </Grid>

                            <DockPanel>
                                <CheckBox Content="{DynamicResource Str_MinimizeOnClose}"
                                          IsChecked="{Binding Automation.MinimizeToTrayOnClose}"
                                          VerticalAlignment="Center" />
                                <ui:Button Content="{DynamicResource Str_MinimizeNow}"
                                           Click="MinimizeToTray_Click"
                                           HorizontalAlignment="Right"
                                           Padding="12,5" />
                            </DockPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Windows Explorer Context Menu Card -->
                    <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_ExplorerTitle}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding Automation.ExplorerMenuStatusText}" Foreground="#9CA3AF" Margin="0,4,0,0" />
                            </StackPanel>
                            <ui:Button Content="{Binding Automation.ExplorerMenuButtonText}"
                                       Command="{Binding Automation.ToggleExplorerMenuCommand}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Padding="14,6" />
                        </DockPanel>
                    </ui:Card>

                    <!-- Watch Activity Log -->
                    <ui:Card Grid.Row="2" Padding="14" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Str_WatchLogTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button Content="{DynamicResource Str_ClearLog}"
                                           Command="{Binding Automation.ClearLogsCommand}"
                                           HorizontalAlignment="Right"
                                           Padding="10,4" />
                            </DockPanel>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Automation.ActivityLogs}"
                                     FontFamily="Consolas"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- TAB 7: SMART OCR & AI -->
            <TabItem Header="{DynamicResource Str_TabSmartAi}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Target Folder + Prompt -->
                    <ui:Card Grid.Row="0" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_FolderLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <ui:TextBox Grid.Column="1" Text="{Binding SmartAi.FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="3" Content="{DynamicResource Str_Downloads}" Command="{Binding SmartAi.SelectDownloadsCommand}" />
                                <ui:Button Grid.Column="5" Content="{DynamicResource Str_Browse}" Click="BrowseSmartAiFolder_Click" />
                                <ui:Button Grid.Column="7"
                                           Content="{DynamicResource Str_PreviewSmartPlan}"
                                           Appearance="Primary"
                                           Command="{Binding SmartAi.GeneratePreviewCommand}" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_InstructionLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <ui:TextBox Grid.Column="1"
                                            Text="{Binding SmartAi.PromptInstruction, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{DynamicResource Str_InstructionHint}" />
                            </Grid>
                        </Grid>
                    </ui:Card>

                    <!-- AI Endpoint Settings & Quick Windows OCR -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Padding="12">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource Str_UseExternalAi}"
                                          IsChecked="{Binding SmartAi.UseExternalAiEndpoint}"
                                          Margin="0,0,0,8" />

                                <Grid IsEnabled="{Binding SmartAi.UseExternalAiEndpoint}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox Grid.Column="0"
                                                Text="{Binding SmartAi.EndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="http://localhost:11434/v1/chat/completions" />
                                    <ui:TextBox Grid.Column="2"
                                                Text="{Binding SmartAi.ModelName, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="llama3.2" />
                                    <ui:TextBox Grid.Column="4"
                                                Text="{Binding SmartAi.ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="API Key (blank for Ollama)" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Column="2" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="{DynamicResource Str_OcrInspectorTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ui:Button Content="{DynamicResource Str_ExtractImageText}"
                                               Click="PickOcrImage_Click"
                                               HorizontalAlignment="Right"
                                               Padding="10,4" />
                                </DockPanel>
                                <TextBox Grid.Row="2"
                                         Text="{Binding SmartAi.OcrExtractedText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Height="48"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas" />
                            </Grid>
                        </ui:Card>
                    </Grid>

                    <!-- Dry-Run Preview -->
                    <DataGrid Grid.Row="2"
                              Style="{StaticResource PreviewGridStyle}"
                              ItemsSource="{Binding SmartAi.PreviewRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource PreviewRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_ColIndex}" Binding="{Binding Index}" Width="48" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColStatus}" Binding="{Binding StatusText}" Width="130" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColSourceFile}" Binding="{Binding SourceName}" Width="1.2*" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColProposedDest}" Binding="{Binding TargetDisplay}" Width="1.4*" />
                            <DataGridTextColumn Header="{DynamicResource Str_ColReason}" Binding="{Binding Note}" Width="1.3*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SmartAi.PreviewSummary}" VerticalAlignment="Center" FontWeight="Medium" />
                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Str_ApplySmartPlan}"
                                   Appearance="Primary"
                                   Padding="18,8"
                                   Click="ApplySmartAi_Click"
                                   IsEnabled="{Binding SmartAi.CanApply}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
