<ui:FluentWindow x:Class="TidyFlow.App.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Str_AboutTitle}"
                 Icon="pack://application:,,,/Assets/tidyflow.ico"
                 Width="640"
                 Height="520"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Str_AboutTitle}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,8,22,12">
            <!-- Hero Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="pack://application:,,,/Assets/logo.png"
                       Width="72"
                       Height="72"
                       Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="TidyFlow" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="VersionTextBlock"
                                   FontSize="14"
                                   Foreground="#38BDF8"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Bottom"
                                   Margin="10,0,0,2" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_AboutTagline}"
                               TextWrapping="Wrap"
                               Foreground="#9CA3AF"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource Str_AboutAuthor}"
                               FontSize="12"
                               Foreground="#9CA3AF" />
                </StackPanel>
            </Grid>

            <!-- Quick Guide Card -->
            <ui:Card Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_AboutGuideTitle}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Str_AboutGuideBody}"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               FontSize="12.5" />
                </StackPanel>
            </ui:Card>

            <!-- Links -->
            <WrapPanel>
                <ui:Button Content="{DynamicResource Str_OpenGitHub}"
                           Click="OpenGitHub_Click"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Padding="12,6" />
                <ui:Button Content="{DynamicResource Str_OpenReleases}"
                           Click="OpenReleases_Click"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Padding="12,6" />
                <ui:Button Content="{DynamicResource Str_OpenHistory}"
                           Click="OpenHistory_Click"
                           Appearance="Transparent"
                           Padding="12,6" />
            </WrapPanel>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="22,0,22,16">
            <ui:Button Content="{DynamicResource Str_Close}"
                       Click="Close_Click"
                       Appearance="Primary"
                       HorizontalAlignment="Right"
                       Padding="20,7" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
